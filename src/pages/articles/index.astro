---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { articles, hasArticles } from '../../lib/articles';
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="Articles" description="Articles on psychotherapy, psychology and AI by Alberto Del Bove, psychoanalytically oriented psychotherapist." noindex={!hasArticles}>
  <section class="wrap head">
    <h1 class="page-title">Articles</h1>
    <p class="lead muted">Writing on psychotherapy, psychology and what changes when people bring AI into their inner lives.</p>
  </section>
  <section class="wrap list">
    {hasArticles ? (
      articles.map((a) => (
        <article class="item">
          <p class="small muted"><time datetime={a.date}>{fmt(a.date)}</time>{a.audience === 'clinicians' ? ', for clinicians' : ''}</p>
          <h2><a href={u(`/articles/${a.slug}/`)}>{a.title}</a></h2>
          <p>{a.description}</p>
        </article>
      ))
    ) : (
      <p class="lead">The first articles are being written. In the meantime, <a href={u('/guides/')}>the guides</a> are all available.</p>
    )}
  </section>
</Base>
<style>
  .head { display: grid; gap: var(--space-4); padding-block: var(--space-7) var(--space-5); }
  .head .lead { max-width: 52ch; }
  .list { display: grid; max-width: 820px; margin-inline: 0; }
  .item { display: grid; gap: var(--space-2); padding-block: var(--space-5); border-top: 1px solid var(--rule); }
  .item h2 { font-size: clamp(24px, 3vw, 30px); line-height: 1.2; }
  .item h2 a { color: var(--ink); text-decoration: none; }
  .item h2 a:hover { text-decoration: underline; text-decoration-color: var(--sage); }
  .item p:last-child { color: var(--ink-muted); max-width: 62ch; }
</style>
