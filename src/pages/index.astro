---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import BundleCard from '../components/BundleCard.astro';
import PriceNote from '../components/PriceNote.astro';
import Book from '../components/Book.astro';
import Shelf from '../components/Shelf.astro';
import Split from '../components/Split.astro';
import Portrait from '../components/Portrait.astro';
import { existsSync } from 'node:fs';
const hasPortrait = existsSync('public/images/author/portrait-480.webp');
import { config } from '../config';
import { lines, productsInLine, bundles } from '../lib/catalog';
import { personSchema, websiteSchema } from '../lib/schema';

const site = Astro.site!;
const aiBooks = productsInLine('ai');
const numberWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const library = bundles.find((b) => b.best)!;
const others = bundles.filter((b) => !b.best);
const desk = ['4549583610', '4582411717', '4549656292'].map((id) => aiBooks.find((p) => p.id === id)!).filter(Boolean);
---
<Base title={config.name} jsonLd={[websiteSchema(site), personSchema(site)]}>
  <section class="hero" aria-labelledby="hero-title">
    <svg class="hero__rings" viewBox="0 0 1000 700" aria-hidden="true">
      <circle cx="560" cy="350" r="300" pathLength="1" />
      <circle cx="700" cy="350" r="300" pathLength="1" />
    </svg>
    <div class="wrap hero__grid">
      <div class="hero__text">
        <Split as="h1" id="hero-title" class="hero__title" text={config.tagline} now />
        <p class="hero__sub">Alongside the AI line, compendia on psychodynamic practice and worksheets for the session. Every title is an instant download through Etsy.</p>
        <div class="hero__actions">
          <a class="tcr-btn tcr-btn--primary" href={u('/guides/')}>Browse the guides</a>
          <a class="tcr-btn tcr-btn--secondary" href={config.etsyShop} target="_blank" rel="noopener">Visit the Etsy shop</a>
        </div>
      </div>

      <div class="desk" aria-label="Three guides from the AI line">
        {desk.map((p, i) => (
          <a class={`desk__book desk__book--${i}`} href={u(`/guides/${p.slug}/`)}>
            <Book product={p} size="l" eager={i === 0} alt={`Cover of ${p.title}`} />
            <span class="desk__label">{p.title}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="wrap hero__foot">
      <blockquote class="tcr-note">
        “A system trained to maximize user satisfaction will, by the mechanics of its training, tend to agree with the person it is speaking to.”
        <cite>From the preface of <a href={u('/guides/the-space-that-answers-back/')}>The Space That Answers Back</a></cite>
      </blockquote>
    </div>
  </section>

  <section class="section lines panel panel--soft" aria-labelledby="lines-title">
    <div class="wrap">
      <h2 id="lines-title" class="section-title lines__title">Three shelves, one consulting room</h2>
      <p class="lines__intro muted" >The AI line comes first because it answers the question colleagues are meeting now. The other two hold the ground it stands on. Each spine opens its guide.</p>
      {lines.map((l, idx) => {
        const items = productsInLine(l.id);
        const n = items.length;
        return (
          <article class:list={['line', { 'line--flip': idx % 2 === 1 }]}>
            <div class="line__text">
              <h3 class="line__name"><a href={u(`/guides/?line=${l.id}`)}>{l.name}</a><span class="line__count">{n} titles</span></h3>
              <p class="line__summary muted">{l.summary}</p>
              <a class="tcr-btn tcr-btn--quiet" href={u(`/guides/?line=${l.id}`)}>See the {numberWords[n] ?? n} titles</a>
            </div>
            <div class="line__shelf">
              <Shelf products={items} size="m" label={`${l.name} titles`} align={idx % 2 === 1 ? 'start' : 'end'} />
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="panel panel--night bundles-band" aria-labelledby="bundles-title">
    <div class="wrap section">
      <div class="bundles-head">
        <h2 id="bundles-title" class="section-title">Bundles cost less than the titles bought one by one</h2>
        <p>If you expect to use more than two guides from a line, a bundle is the better way to buy. The Complete Library holds everything in the shop.</p>
      </div>
      <div class="bundle-grid">
        <BundleCard bundle={library} wide />
        {others.map((b) => <BundleCard bundle={b} />)}
      </div>
      <div class="bundles-foot">
        <a class="tcr-btn tcr-btn--quiet on-night-link" href={u('/bundles/')}>Compare the bundles title by title</a>
        <PriceNote />
      </div>
    </div>
  </section>

  <section class="section wrap why" aria-labelledby="why-title">
    <h2 id="why-title" class="section-title why__title">Why these guides</h2>
    <blockquote class="why__quote">“A section that stays empty for months is information too.”<cite>From the observation grid in <a href={u('/guides/ai-observation-grid/')}>AI in the Consulting Room</a></cite></blockquote>
    <dl class="why__list">
      <div class="why__row">
        <dt>Clinical, not generic</dt>
        <dd>Each guide starts from a question that came up in a session and returns to the session: what to notice, what to ask, and where the work tends to go wrong. Nothing here was produced to fill a catalogue.</dd>
      </div>
      <div class="why__row">
        <dt>Written by a practicing analyst</dt>
        <dd>I see patients every week, and I write between sessions, in the language we use with colleagues. The vignettes are composite and fictional, and nothing pretends to more certainty than the field has.</dd>
      </div>
      <div class="why__row">
        <dt>Honest about what the tools are</dt>
        <dd>The worksheets and grids are reflection and observation tools. They have no scoring, norms or diagnostic status, and each page says so before you buy.</dd>
      </div>
      <div class="why__row">
        <dt>Useful across orientations</dt>
        <dd>Most of the material is written from a psychodynamic position, but it attends to things every orientation works with: the frame, the relationship, and what changes in the room.</dd>
      </div>
    </dl>
  </section>

  <section class="author" aria-labelledby="author-title">
    <div class="wrap author__inner">
      {hasPortrait ? <Portrait /> : <svg class="author__rings" viewBox="0 0 260 160" aria-hidden="true"><circle cx="100" cy="80" r="64" pathLength="1" /><circle cx="160" cy="80" r="64" pathLength="1" /></svg>}
      <div class="author__text">
        <h2 id="author-title" class="section-title">Who writes them</h2>
        <p class="lead">I'm Alberto Del Bove, a psychologist and psychoanalytically oriented psychotherapist, licensed since 2018 and trained in Demand Analysis at SPS in Rome. I see adults online and in Itri, near Rome, and I write these guides between sessions, usually starting from a question that came up in the room.</p>
        <a class="tcr-btn tcr-btn--secondary" href={u('/about/')}>More about the author</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; padding-block: var(--space-6) var(--space-7); }
  @media (max-width: 979px) { .hero__rings { display: none; } }
  .hero__rings { position: absolute; inset-inline-end: -12%; inset-block-start: -4%; width: min(1100px, 120vw); height: auto; pointer-events: none; }
  .hero__rings circle { fill: none; stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 0; vector-effect: non-scaling-stroke; }
  .hero__rings circle:first-child { stroke: var(--sage); }
  .hero__rings circle:last-child { stroke: var(--rule); }
  .hero::before { content: ''; position: absolute; inset: -10% -10% auto 35%; height: 110%; background: radial-gradient(50% 50% at 55% 45%, rgba(156, 175, 154, 0.16), transparent 70%); pointer-events: none; }
  .hero__grid { position: relative; display: grid; gap: var(--space-6); grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 980px) { .hero__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); min-height: min(76vh, 740px); } }
  .hero__text { display: grid; gap: var(--space-5); }
  .hero__text :global(.hero__title) { font-size: clamp(44px, 5.3vw, 84px); line-height: 0.98; font-weight: 400; letter-spacing: -0.028em; max-width: 15ch; }
  .hero__sub { font-size: 19px; line-height: 1.55; color: var(--ink-muted); max-width: 44ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* The desk: three guides laid out, each one a link */
  .desk { position: relative; height: clamp(380px, 40vw, 520px); }
  .desk__book { position: absolute; display: grid; justify-items: center; gap: var(--space-3); text-decoration: none; color: var(--ink); }
  .desk__book :global(.book) { --w: clamp(170px, 17vw, 240px); }
  .desk__book--0 { left: 0; top: 14%; z-index: 2; }
  .desk__book--0 :global(.book) { --ry: 22deg; --rx: -5deg; }
  .desk__book--1 { right: 2%; top: 0; z-index: 1; }
  .desk__book--1 :global(.book) { --ry: 34deg; --rx: -6deg; }
  .desk__book--2 { left: 32%; bottom: 0; z-index: 3; }
  .desk__book--2 :global(.book) { --ry: 16deg; --rx: -3deg; }
  .desk__label { font-size: 13px; font-weight: 550; color: var(--ink-muted); opacity: 0; transform: translateY(-4px); transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out); }
  .desk__book:hover .desk__label, .desk__book:focus-visible .desk__label { opacity: 1; transform: none; }
  .desk__book:hover { z-index: 4; }
  @media (max-width: 979px) {
    .desk { height: auto; display: flex; justify-content: center; gap: 0; padding-block: var(--space-5); }
    .desk__book { position: relative; inset: auto; }
    .desk__book :global(.book) { --w: clamp(96px, 27vw, 170px); }
    .desk__book + .desk__book { margin-left: -6%; }
    .desk__label { display: none; }
  }

  .hero__foot { position: relative; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-6); margin-top: var(--space-6); }

  /* ---------- Lines as shelves ---------- */
  .lines__title { max-width: 19ch; }
  .lines__intro { max-width: 52ch; margin-top: var(--space-4); margin-bottom: var(--space-7); }
  .line { display: grid; gap: var(--space-6); align-items: end; padding-block: var(--space-7); border-top: 1px solid var(--rule); }
  @media (min-width: 980px) { .line { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } .line--flip .line__text { order: 2; } }
  .line__text { display: grid; gap: var(--space-3); justify-items: start; }
  .line__name { font-size: clamp(40px, 4.6vw, 62px); line-height: 1; font-weight: 450; }
  .line__name a { color: inherit; text-decoration: none; }
  .line__count { display: block; margin-top: var(--space-3); font-family: var(--font-sans); font-size: 15px; font-weight: 450; letter-spacing: 0; color: var(--ink-muted); }
  .line__summary { max-width: 44ch; margin-bottom: var(--space-2); }
  .line__shelf { min-width: 0; padding: var(--space-7) 0 var(--space-5); }
  @media (max-width: 979px) { .line__shelf :global(.shelf) { margin-inline: auto; } }

  /* ---------- Bundles ---------- */
  .bundles-band { margin-top: var(--inset); }
  .bundles-head { display: grid; gap: var(--space-4); max-width: 62ch; margin-bottom: var(--space-7); }
  .bundles-head p { color: var(--on-night-muted); font-size: 18px; }
  .bundle-grid { display: grid; gap: var(--space-5); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 820px) { .bundle-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .bundle-grid > :global(:first-child) { grid-column: 1 / -1; } }
  .bundles-foot { display: grid; gap: var(--space-4); margin-top: var(--space-6); color: var(--on-night-muted); }
  .on-night-link { color: var(--on-night); justify-self: start; }
  .on-night-link:hover { color: var(--sage); }

  /* ---------- Why: an editorial list, not a row of cards ---------- */
  .why { display: grid; gap: var(--space-6); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 980px) { .why { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-areas: 'title list' 'quote list'; column-gap: var(--space-7); } .why__title { grid-area: title; } .why__quote { grid-area: quote; align-self: start; position: sticky; top: 140px; } .why__list { grid-area: list; } }
  .why__quote { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: clamp(26px, 2.6vw, 34px); line-height: 1.25; font-weight: 450; max-width: 18ch; color: var(--ink); }
  .why__quote cite { display: block; margin-top: var(--space-4); font: normal 400 14px/1.5 var(--font-sans); color: var(--ink-muted); max-width: 32ch; }
  .why__list { margin: 0; border-top: 1px solid var(--rule); }
  .why__row { display: grid; gap: var(--space-2) var(--space-6); padding-block: var(--space-5) var(--space-6); border-bottom: 1px solid var(--rule); transition: background-color 0.5s var(--ease-out); }
  @media (min-width: 700px) { .why__row { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); } }
  .why__row dt { font-family: var(--font-serif); font-size: clamp(26px, 2.4vw, 32px); line-height: 1.08; font-weight: 500; }
  .why__row dd { margin: 0; color: var(--ink-muted); }

  /* ---------- Author ---------- */
  .author { position: relative; }
  .author__inner { display: grid; gap: var(--space-5); padding-block: var(--space-6) 0; align-items: center; }
  @media (min-width: 860px) { .author__inner { grid-template-columns: 300px minmax(0, 1fr); gap: var(--space-7); } }
  .author__rings { width: 260px; }
  .author__rings circle { fill: none; stroke-width: 1.5; stroke-dasharray: 1; vector-effect: non-scaling-stroke; }
  .author__rings circle:first-child { stroke: var(--sage); }
  .author__rings circle:last-child { stroke: var(--ink); opacity: 0.5; }
  .author__text { display: grid; gap: var(--space-5); justify-items: start; max-width: 60ch; }

</style>

