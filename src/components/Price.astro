---
// Prezzo con eventuale sconto Etsy. Il prezzo scontato porta la data di fine:
// dopo quella data il browser nasconde lo sconto da solo (classe promo-ended su <html>).
import type { Price as P } from '../lib/catalog';
import { formatPrice, promotion, promoEndsLabel } from '../lib/catalog';
interface Props { price?: P; sale?: P; size?: 'sm' | 'lg'; badge?: boolean; class?: string }
const { price, sale, size = 'sm', badge = true, class: cls = '' } = Astro.props;
---
{price && (
  sale ? (
    <span class={`price price--${size} ${cls}`}>
      <span class="price__sale">
        <strong class="price__now">{formatPrice(sale)}</strong>
        <s class="price__was"><span class="visually-hidden">Regular price </span>{formatPrice(price)}</s>
        {badge && promotion && <span class="price__badge">{promotion.percent}% off until {promoEndsLabel}</span>}
      </span>
      <strong class="price__base">{formatPrice(price)}</strong>
    </span>
  ) : (
    <span class={`price price--${size} ${cls}`}><strong class="price__now">{formatPrice(price)}</strong></span>
  )
)}
