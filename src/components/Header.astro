---
import { u } from '../lib/url';
import { config } from '../config';
import { hasArticles } from '../lib/articles';
import EtsyIcon from './EtsyIcon.astro';
const path = Astro.url.pathname;
const links = [
  { href: u('/guides/'), label: 'Guides' },
  { href: u('/bundles/'), label: 'Bundles' },
  ...(hasArticles ? [{ href: u('/articles/'), label: 'Articles' }] : []),
  { href: u('/about/'), label: 'About' },
  { href: u('/institutes/'), label: 'For institutes' },
];
const current = (href: string) => path === href || (href !== u('/') && path.startsWith(href));
---
<header class="site-header">
  <div class="site-header__bar tcr-header">
    <a class="tcr-wordmark" href={u('/')} aria-label="The Consulting Room, home"><span class="tcr-ring" aria-hidden="true"></span>The Consulting Room</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" /></svg>
      <span class="menu-toggle__label">Menu</span>
    </button>
    <nav id="site-nav" class="tcr-nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a class="tcr-btn tcr-btn--secondary nav-etsy" href={config.etsyShop} target="_blank" rel="noopener">Etsy shop <EtsyIcon /></a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; padding: 10px var(--inset) 0; }
  .site-header__bar {
    max-width: calc(var(--page-max) + 2 * var(--space-5)); margin-inline: auto;
    padding: 8px 8px 8px var(--space-5); border-radius: var(--radius-pill);
    background: linear-gradient(180deg, #ffffff, #f8f8f5);
    box-shadow: inset 0 1px 0 rgba(var(--hl), 0.9), inset 0 0 0 1px rgba(var(--sc), 0.07), 0 1px 2px rgba(var(--sc), 0.05);
    transition: box-shadow 0.5s var(--ease-out), background 0.5s var(--ease-out);
  }
  @media (prefers-color-scheme: dark) { .site-header__bar { background: linear-gradient(180deg, #182434, #141e2c); box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), inset 0 0 0 1px rgba(255,255,255,0.06); } }
  .site-header[data-scrolled] .site-header__bar { box-shadow: inset 0 1px 0 rgba(var(--hl), 0.9), inset 0 0 0 1px rgba(var(--sc), 0.08), 0 2px 4px rgba(var(--sc), 0.05), 0 18px 40px -18px rgba(var(--sc), 0.35); }
  .tcr-nav a:not(.tcr-btn) { padding-block: 12px; }
  .nav-etsy { min-block-size: 44px; padding: var(--space-2) var(--space-4); }
  .menu-toggle { display: none; align-items: center; gap: var(--space-2); min-block-size: 44px; padding: var(--space-2) var(--space-4); border: 0; border-radius: var(--radius-pill); background: linear-gradient(180deg, rgba(var(--hl), 1), var(--surface)); box-shadow: inset 0 0 0 1px rgba(var(--sc), 0.18), 0 4px 10px -6px rgba(var(--sc), 0.4); color: var(--ink); font: 550 15px/1 var(--font-sans); cursor: pointer; }
  .menu-toggle svg path { transition: transform 0.4s var(--ease-out), opacity 0.3s; transform-origin: center; }
  .site-header[data-open] .menu-toggle svg path { transform: scaleX(0.6); }
  @media (max-width: 879px) {
    .menu-toggle { display: inline-flex; }
    .tcr-wordmark { font-size: 20px; }
    .site-header__bar { flex-wrap: wrap; border-radius: 26px; padding-left: var(--space-4); }
    .tcr-nav { display: none; flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 0; padding: var(--space-2) var(--space-2) var(--space-3); }
    .tcr-nav a:not(.tcr-btn) { padding-block: var(--space-3); border-block-end: 1px solid var(--rule); font-family: var(--font-serif); font-size: 26px; }
    .tcr-nav a:not(.tcr-btn)::after { display: none; }
    .tcr-nav .nav-etsy { margin-block-start: var(--space-4); }
    .site-header[data-open] .tcr-nav { display: flex; }
    .site-header[data-open] .tcr-nav > * { animation: menu-in 0.5s var(--ease-out) both; }
    .site-header[data-open] .tcr-nav > :nth-child(2) { animation-delay: 0.04s; }
    .site-header[data-open] .tcr-nav > :nth-child(3) { animation-delay: 0.08s; }
    .site-header[data-open] .tcr-nav > :nth-child(4) { animation-delay: 0.12s; }
    .site-header[data-open] .tcr-nav > :nth-child(5) { animation-delay: 0.16s; }
    .site-header[data-open] .tcr-nav > :nth-child(6) { animation-delay: 0.2s; }
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const onScroll = () => header?.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    const label = toggle.querySelector('.menu-toggle__label');
    if (label) label.textContent = open ? 'Close' : 'Menu';
    header?.toggleAttribute('data-open', open);
  });
</script>
