---
// Uno scaffale: i libri in piedi mostrano il dorso; al passaggio del mouse escono e girano la copertina.
// Ogni dorso è una colonna proporzionale: se lo spazio manca, tutti si restringono insieme e nessuno resta nascosto.
import { u } from '../lib/url';
import type { Product } from '../lib/catalog';
import Book from './Book.astro';
interface Props { products: Product[]; size?: 's' | 'm'; link?: boolean; label?: string; align?: 'start' | 'end' | 'center' }
const { products, size = 's', link = true, label, align = 'center' } = Astro.props;
const w = size === 's' ? 150 : 230;
const widths = products.map((p) => Math.round(w * Math.min(0.22, Math.max(0.14, 0.12 + p.pages / 500))));
const total = widths.reduce((a, b) => a + b, 0) + (products.length - 1) * 3;
---
<div
  class={`shelf shelf--${align}`}
  role={label ? 'list' : undefined}
  aria-label={label}
  data-shelf
  style={`--w:${w}px;--shelf-max:${total}px;grid-template-columns:${widths.map((x) => `minmax(0, ${x}fr)`).join(' ')}`}
>
  {products.map((p, i) => (
    <div class="shelf__slot" role={label ? 'listitem' : undefined} style={`--i:${i}`}>
      {link ? (
        <a href={u(`/guides/${p.slug}/`)} aria-label={p.title}>
          <Book product={p} size={size} pose="spine" minDepth={0.15} />
        </a>
      ) : (
        <Book product={p} size={size} pose="spine" minDepth={0.15} />
      )}
    </div>
  ))}
</div>
