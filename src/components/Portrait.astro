---
import { u } from '../lib/url';
// Ritratto dell'autore. Compare solo se esiste public/images/author/portrait-480.webp (generato da npm run images).
import { existsSync } from 'node:fs';
interface Props { class?: string; eager?: boolean }
const { class: cls = '', eager = false } = Astro.props;
const has = existsSync('public/images/author/portrait-480.webp');
---
{has && (
  <figure class={`portrait ${cls}`}>
    <span class="portrait__ring" aria-hidden="true"></span>
    <img src={u('/images/author/portrait-480.webp')} srcset={`${u('/images/')}author/portrait-480.webp 480w, ${u('/images/')}author/portrait-960.webp 960w`} sizes="(min-width: 860px) 300px, 70vw" width="480" height="600" alt="Alberto Del Bove" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </figure>
)}
<style>
  .portrait { position: relative; margin: 0 0 var(--space-6); inline-size: min(300px, 70vw); aspect-ratio: 4 / 5; }
  .portrait img { position: relative; z-index: 1; inline-size: 100%; block-size: 100%; object-fit: cover; border-radius: 26px; filter: saturate(0.88) contrast(1.02);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06), 0 2px 4px rgba(var(--sc), 0.08), 0 24px 48px -18px rgba(var(--sc), 0.45), 0 60px 90px -50px rgba(var(--sc), 0.5);
    transform: rotate(-1.5deg); transition: transform 0.9s var(--ease-out), filter 0.9s var(--ease-out); }
  .portrait:hover img { transform: rotate(0deg) translateY(-4px); filter: saturate(1) contrast(1.02); }
  .portrait__ring { position: absolute; z-index: 2; inline-size: 38%; aspect-ratio: 1; inset-inline-end: -12%; inset-block-end: -8%; border-radius: 50%; border: 1.5px solid var(--sage); transition: transform 0.9s var(--ease-spring); }
  .portrait__ring::after { content: ''; position: absolute; inset: -1.5px; border-radius: 50%; border: 1.5px solid var(--ink); opacity: 0.4; transform: translateX(-38%); transition: transform 0.9s var(--ease-spring); }
  .portrait:hover .portrait__ring::after { transform: translateX(-20%); }
</style>
